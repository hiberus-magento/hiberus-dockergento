{
    "ai-init": {
        "description": "Initialize AI tools configuration (skills/agents) via interactive wizard",
        "example": "ai-init\n\t hm ai-init --platforms=claude,cursor --types=hyva,magento --resources=skills,agents",
        "opts": [
            {
                "name": {
                    "long": "platforms"
                },
                "description": "Comma-separated list of AI platforms (claude, cursor, codex, copilot, gemini, opencode)"
            },
            {
                "name": {
                    "long": "types"
                },
                "description": "Comma-separated list of skill types (hyva, acs, magento, php)"
            },
            {
                "name": {
                    "long": "resources"
                },
                "description": "Resource types to download (skills, agents, or both)"
            },
            {
                "name": {
                    "long": "repository"
                },
                "description": "Custom repository URL to include"
            },
            {
                "name": {
                    "long": "branch"
                },
                "description": "Branch name for custom repository (default: main)"
            }
        ],
        "group": "ai"
    },
    "ai-pull": {
        "description": "Download/update AI tools (skills/agents) from configured repositories",
        "example": "ai-pull\n\t hm ai-pull --force",
        "opts": [
            {
                "name": {
                    "long": "force"
                },
                "description": "Force re-download and overwrite existing skills/agents"
            }
        ],
        "group": "ai"
    },
    "ai-reset": {
        "description": "Remove downloaded AI tools while preserving custom skills/agents",
        "example": "ai-reset\n\t hm ai-reset --confirm",
        "opts": [
            {
                "name": {
                    "long": "confirm"
                },
                "description": "Skip confirmation prompt (for automation)"
            }
        ],
        "group": "ai"
    },
    "bash": {
        "description": "Connect into container using bash [Default container: php]",
        "opts": [
            {
                "name": {
                    "short": "r",
                    "long": "root"
                },
                "description": "Use bash as root user"
            }
        ],
        "group": "tools"
    },
    "clean": {
        "description": "Collect what environments that no longer exist left behind",
        "usage": "clean [--force]",
        "opts": [
            {
                "name": {
                    "short": "",
                    "long": "force"
                },
                "description": "Actually delete; without it nothing is removed"
            }
        ],
        "group": "environment"
    },
    "cloud": {
        "description": "Magento Cloud Cli",
        "usage": "cloud [options]",
        "group": "tools"
    },
    "cloud-login": {
        "description": "Magento Cloud Login",
        "group": "tools"
    },
    "compatibility": {
        "description": "Check Magento version compatibility",
        "group": "tools"
    },
    "composer": {
        "description": "Execute composer inside php container",
        "args": [
            {
                "name": "composer-subcommands",
                "description": "composer commands (install, update, ...)"
            }
        ],
        "group": "magento"
    },
    "config-env": {
        "description": "Launch config set of project for local environment",
        "usage": "config-env",
        "group": "tools"
    },
    "copy-from-container": {
        "description": "(Mac only) Copy and overwrite container content into host",
        "args": [
            {
                "name": "path",
                "description": "Do not ask confirmation to remove host destination"
            }
        ],
        "example": "copy-from-container generated",
        "mac": true,
        "group": "files"
    },
    "copy-to-container": {
        "description": "(Mac only) Copy and overwrite host content into container",
        "args": [
            {
                "name": "path",
                "description": "Folder to copy",
                "multiple": true
            }
        ],
        "example": "copy-to-container vendor",
        "mac": true,
        "group": "files"
    },
    "create-project": {
        "description": "Create new magento project inside current directory",
        "example": "create-project -u -e=community -p=\"my-project\" -r=\".\"  -v=2.4.5-p1",
        "opts": [
            {
                "name": {
                    "short": "e",
                    "long": "edition"
                },
                "description": "Magento edition (community | enterprise) "
            },
            {
                "name": {
                    "short": "p",
                    "long": "project-name"
                },
                "description": "Project name. Domain is compose with <project_name>.local"
            },
            {
                "name": {
                    "short": "r",
                    "long": "root-directory"
                },
                "description": "Project relative path"
            },
            {
                "name": {
                    "short": "u",
                    "long": "use-default"
                },
                "description": "Use default settings: \n\t\t\t- edition = community \n\t\t\t- version = <last-version> \n\t\t\t- project-name = <basename> \n\t\t\t- root-directory = '.' \n\t\t\t- basic-settings = <default-local-settings>)"
            },
            {
                "name": {
                    "short": "v",
                    "long": "version"
                },
                "description": "Magento version (you can see all available version with hm compatibility command)"
            }
        ],
        "group": "tools"
    },
    "db": {
        "description": "Named copies of this project's database",
        "usage": "db <snapshot|list|restore|remove|clear> [options]",
        "args": [
            {
                "name": "<subcommand>",
                "description": "snapshot, list, restore, remove or clear"
            }
        ],
        "opts": [
            {
                "name": {
                    "short": "",
                    "long": "name=<name>"
                },
                "description": "Name for the snapshot (default: the date)"
            },
            {
                "name": {
                    "short": "",
                    "long": "force"
                },
                "description": "Overwrite a snapshot that already exists"
            },
            {
                "name": {
                    "short": "",
                    "long": "all"
                },
                "description": "With clear: every project's snapshots, not just this one's"
            }
        ],
        "group": "database"
    },
    "debug-off": {
        "description": "Disable xDebug",
        "group": "tools"
    },
    "debug-on": {
        "description": "Enable xDebug",
        "group": "tools"
    },
    "describe": {
        "description": "Show everything that defines the current project",
        "usage": "describe [options]",
        "opts": [
            {
                "name": {
                    "short": "",
                    "long": "with-secrets"
                },
                "description": "Include database credentials in the output"
            }
        ],
        "group": "environment"
    },
    "docker-compose": {
        "description": "Execute docker compose using configuration for your machine",
        "args": [
            {
                "name": "[docker-opts]",
                "description": "docker compose commands (exec, up, down, ...)"
            }
        ],
        "group": "tools"
    },
    "docker-stop-all": {
        "description": "Stop all running containers",
        "group": "tools"
    },
    "doctor": {
        "description": "Diagnose the machine and the current project",
        "usage": "doctor [options]",
        "opts": [
            {
                "name": {
                    "short": "",
                    "long": "only=<check>"
                },
                "description": "Run a single check by id"
            }
        ],
        "group": "environment"
    },
    "down": {
        "description": "Stop and remove containers, networks, images, and volumes (-v)",
        "example": "down -v",
        "group": "environment"
    },
    "exec": {
        "description": "Execute a command in a running container [Default container: php]",
        "opts": [
            {
                "name": {
                    "short": "r",
                    "long": "root"
                },
                "description": "Run command as root user"
            }
        ],
        "example": "exec ls -lah",
        "group": "tools"
    },
    "grunt": {
        "description": "Prepare grunt configuration and compile theme styles using grunt",
        "example": "grunt Hiberus/luma es_ES",
        "args": [
            {
                "name": "Vendor/theme",
                "description": "Theme vendor reference"
            },
            {
                "name": "locale_LOCALE",
                "description": "Locale code"
            }
        ],
        "group": "magento"
    },
    "install": {
        "description": "Execute setup:install Magento command with custom config",
        "opts": [
            {
                "name": {
                    "short": "u",
                    "long": "use-default"
                },
                "description": "Use default settings like currency, admin-user, password-user, etc."
            }
        ],
        "group": "magento"
    },
    "launch": {
        "description": "Open the project in the browser",
        "usage": "launch [options]",
        "opts": [
            {
                "name": {
                    "short": "",
                    "long": "admin"
                },
                "description": "Open the admin panel"
            },
            {
                "name": {
                    "short": "",
                    "long": "mail"
                },
                "description": "Open the mail catcher (--mailhog and --mailpit also work)"
            },
            {
                "name": {
                    "short": "",
                    "long": "rabbitmq"
                },
                "description": "Open the message queue"
            },
            {
                "name": {
                    "short": "",
                    "long": "search"
                },
                "description": "Open the search engine"
            }
        ],
        "group": "environment"
    },
    "list": {
        "description": "List every Dockergento environment on this machine",
        "usage": "list",
        "group": "environment"
    },
    "logs": {
        "description": "Show the logs of the project, or of the services named",
        "usage": "logs [service...] [options]",
        "opts": [
            {
                "name": {
                    "short": "f",
                    "long": "follow"
                },
                "description": "Follow the log output"
            },
            {
                "name": {
                    "short": "n",
                    "long": "tail=<n>"
                },
                "description": "Show only the last n lines"
            },
            {
                "name": {
                    "short": "",
                    "long": "since=<time>"
                },
                "description": "Show logs since a timestamp or relative time"
            },
            {
                "name": {
                    "short": "t",
                    "long": "timestamps"
                },
                "description": "Show timestamps"
            }
        ],
        "group": "environment"
    },
    "magento": {
        "description": "Execute Magento console commands",
        "args": [
            {
                "name": "magento-subcommand",
                "description": "Execute Magento subcommand."
            }
        ],
        "example": "magento cache:clean",
        "group": "magento"
    },
    "masquerade": {
        "example": "masquerade\n\n\t >>> To add proyect config files create the following folder: config/docker/masquerade/magento2 and include de yaml files (.yaml) inside the newly created folder (magento2).",
        "description": "Execute masquerade tool. 'hm masquerade --help' to view more info. ",
        "group": "database"
    },
    "mysql": {
        "example": "mysql < local-path/my-dump.sql\n\t hm mysql -d -i=my-dump.sql",
        "description": "Execute mysql command into container",
        "opts": [
            {
                "name": {
                    "short": "d",
                    "long": "definers"
                },
                "description": "Process database before import (with -i option), removing all DEFINER root"
            },
            {
                "name": {
                    "short": "i",
                    "long": "import"
                },
                "description": "Import SQL dump and config minimal settings for local environment"
            },
            {
                "name": {
                    "short": "q",
                    "long": "query"
                },
                "description": "Execute query"
            }
        ],
        "group": "database"
    },
    "mysqldump": {
        "example": "mysqldump local-path/my-dump.sql",
        "description": "Execute mysqldump command into container",
        "args": [
            {
                "name": "path",
                "description": "Sql file path when you want save dump"
            }
        ],
        "group": "database"
    },
    "n98-magerun": {
        "description": "Execute n98-magerun tool",
        "usage": "n98-magerun [options]",
        "group": "magento"
    },
    "npm": {
        "description": "Execute npm commands into node container",
        "args": [
            {
                "name": "npm-subcommand",
                "description": "Execute npm subcommand."
            }
        ],
        "group": "magento"
    },
    "purge": {
        "description": "Remove all magento generated code (caches, generated, static, view_preprocessed)",
        "group": "magento"
    },
    "rebuild": {
        "description": "Rebuild docker services with current configuration",
        "group": "environment"
    },
    "restart": {
        "description": "Restart docker services",
        "args": [
            {
                "name": "service-name",
                "description": "Restart specific container of the service-name."
            }
        ],
        "example": "restart phpfpm",
        "group": "environment"
    },
    "set-host": {
        "example": "set-host my-project.local",
        "description": "Set host name in /etc/hosts and core_config_data",
        "args": [
            {
                "name": "domain",
                "description": "Domain is desired to set"
            }
        ],
        "group": "tools"
    },
    "setup": {
        "description": "Dockerize magento project",
        "example": "setup -u -i -p=magento --domain=magento.local",
        "opts": [
            {
                "name": {
                    "short": "d",
                    "long": "domain"
                },
                "description": "Domain of local host"
            },
            {
                "name": {
                    "short": "D",
                    "long": "dump"
                },
                "description": "Dump for importing"
            },
            {
                "name": {
                    "short": "f",
                    "long": "force"
                },
                "description": "Override docker-compose configurations"
            },
            {
                "name": {
                    "short": "i",
                    "long": "install"
                },
                "description": "Chose magento installation option"
            },
            {
                "name": {
                    "short": "p",
                    "long": "project-name"
                },
                "description": "Project name. Domain is compose with <project_name>.local"
            },
            {
                "name": {
                    "short": "r",
                    "long": "root-directory"
                },
                "description": "Project relative path"
            },
            {
                "name": {
                    "short": "u",
                    "long": "use-default"
                },
                "description": "Use default settings of user for language, currency, ..."
            }
        ],
        "group": "environment"
    },
    "ssl": {
        "description": "Install SSL certificates for docker environment",
        "args": [
            {
                "name": "domain",
                "description": "Create certificate for specific domain."
            }
        ],
        "example": "ssl domain.local",
        "group": "tools"
    },
    "start": {
        "description": "Start docker services",
        "opts": [
            {
                "name": {
                    "short": "s",
                    "long": "switch"
                },
                "description": "Stop all docker container before execute start"
            }
        ],
        "args": [
            {
                "name": "service-name",
                "description": "Start specific container of the service-name."
            }
        ],
        "example": "start phpfpm",
        "group": "environment"
    },
    "stop": {
        "description": "Stop docker services",
        "args": [
            {
                "name": "service-name",
                "description": "Stop specific container of the service-name."
            }
        ],
        "example": "stop phpfpm",
        "group": "environment",
        "usage": "stop [options]",
        "opts": [
            {
                "name": {
                    "short": "",
                    "long": "snapshot"
                },
                "description": "Save a database snapshot before stopping"
            }
        ]
    },
    "switch": {
        "description": "Switch the installation to another version or branch",
        "usage": "switch [<version|branch>|--stable|--list]",
        "group": "versions",
        "opts": [
            {
                "name": {
                    "short": "",
                    "long": "list"
                },
                "description": "Show the available versions and branches"
            },
            {
                "name": {
                    "short": "",
                    "long": "stable"
                },
                "description": "Switch back to the stable branch"
            }
        ]
    },
    "test-integration": {
        "description": "Execute your magento integration tests",
        "group": "magento"
    },
    "test-unit": {
        "description": "Execute your magento unit test",
        "group": "magento"
    },
    "transfer-db": {
        "description": "Transfer database form external source to this project",
        "group": "database"
    },
    "transfer-media": {
        "description": "Transfer multimedia recurses form external source to this project",
        "group": "files"
    },
    "tui": {
        "description": "Open the dashboard: every environment on this machine, on one screen",
        "usage": "tui",
        "group": "environment"
    },
    "update": {
        "description": "Update hiberus docker tool",
        "group": "versions"
    },
    "version": {
        "description": "Show the version of the tool, Docker and Compose",
        "usage": "version",
        "group": "versions"
    },
    "varnish-off": {
        "description": "Turn off varnish service",
        "group": "tools"
    },
    "varnish-on": {
        "description": "Turn on varnish service",
        "group": "tools"
    },
    "_examples": [
        {
            "command": "hm start",
            "description": "Bring the environment up"
        },
        {
            "command": "hm magento cache:clean",
            "description": "Run a Magento command"
        },
        {
            "command": "hm mysql -i dump.sql",
            "description": "Import a database dump"
        },
        {
            "command": "hm describe",
            "description": "Show what this project is"
        },
        {
            "command": "hm doctor",
            "description": "Diagnose the machine and the project"
        }
    ],
    "_global": {
        "opts": [
            {
                "name": {
                    "short": "",
                    "long": "json"
                },
                "description": "Force machine readable JSON output"
            },
            {
                "name": {
                    "short": "",
                    "long": "no-json"
                },
                "description": "Force human readable text output"
            },
            {
                "name": {
                    "short": "",
                    "long": "yes"
                },
                "description": "Never ask questions: use defaults or fail with an actionable error"
            },
            {
                "name": {
                    "short": "",
                    "long": "force"
                },
                "description": "Run a command refused from a git worktree (one invocation only)"
            },
            {
                "name": {
                    "short": "",
                    "long": "no-color"
                },
                "description": "Never colour the output (see also NO_COLOR)"
            }
        ]
    },
    "_groups": [
        {
            "id": "environment",
            "title": "Environment"
        },
        {
            "id": "magento",
            "title": "Magento"
        },
        {
            "id": "database",
            "title": "Database"
        },
        {
            "id": "files",
            "title": "Files"
        },
        {
            "id": "tools",
            "title": "Tools"
        },
        {
            "id": "versions",
            "title": "Versions"
        },
        {
            "id": "ai",
            "title": "AI tools"
        },
        {
            "id": "other",
            "title": "Other"
        }
    ]
}

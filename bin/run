#!/usr/bin/env bash
set -euo pipefail

export COMMAND_BIN_NAME="hm"
export COMMAND_TOOLNAME="Hiberus Dockergento"

#
# Resolve absolute path directories
#
resolve_absolute_dir() {
    source="${BASH_SOURCE[0]}"

    while [ -h "$source" ]; do

        # resolve $source until the file is no longer a symlink
        DIR=$(cd -P "$(dirname "$source")" && pwd)
        source="$(readlink "$source")"

        # if $source was a relative symlink, 
        # we need to resolve it relative to the path where the symlink file was located
        [[ $source != /* ]] && source="$DIR/$source"
    done

    ABSOLUTE_BIN_PATH="$(cd -P "$(dirname "$source")" && pwd)"
    # Normalised, not "<bin>/..": this path is printed to the user by `hm --version`
    ABSOLUTE_PATH="$(cd -P "$ABSOLUTE_BIN_PATH/.." && pwd)"
}

#
# Export absolute paths of main directories
#
init_dirs() {
    resolve_absolute_dir
    export COMMAND_BIN_DIR="$ABSOLUTE_PATH"
    export COMMANDS_DIR="$ABSOLUTE_PATH/console/commands"
    export DATA_DIR="$ABSOLUTE_PATH/data"
    export HELPERS_DIR="$ABSOLUTE_PATH/console/helpers"

    # From a git worktree everything is resolved against the main checkout: its
    # configuration, its properties and its containers
    source "$HELPERS_DIR"/worktree.sh
    hm_resolve_project_root
    export HM_ROOT
    export HM_IS_WORKTREE
    export HM_WORKTREE

    export CUSTOM_COMMANDS_DIR="$HM_ROOT/config/$COMMAND_BIN_NAME/commands"
    export DOCKER_CONFIG_DIR="config/docker"
    export CUSTOM_PROPERTIES_DIR="$HM_ROOT/$DOCKER_CONFIG_DIR"
    export TASKS_DIR="$ABSOLUTE_PATH/console/tasks"
    export COMPONENTS_DIR="$ABSOLUTE_PATH/console/components"
}

#
# Import all necessary dependencies
#
import_dependencies() {
    source "$TASKS_DIR"/load_properties.sh
    source "$COMPONENTS_DIR"/print_message.sh
    source "$COMPONENTS_DIR"/print_json.sh
    source "$HELPERS_DIR"/exit_codes.sh
    source "$HELPERS_DIR"/global_options.sh
    source "$HELPERS_DIR"/map_arguments.sh
    source "$HELPERS_DIR"/process_hm_options.sh
    source "$TASKS_DIR"/set_machine_specific_properties.sh
    source "$TASKS_DIR"/set_environment_labels.sh
}

#
# Check if exit command in native commands and custom commands
#
check_command_dir() {
    if [ ! -f "$COMMANDS_DIR/$command_name" ]; then
        if [[ ! -f "$CUSTOM_COMMANDS_DIR/$command_name" ]]; then
            hm_fail "$HM_EXIT_USAGE" "command_not_found" \
                "Command not found: ${command_name%.sh}" \
                "$COMMAND_BIN_NAME --help"
        else
            COMMANDS_DIR="$CUSTOM_COMMANDS_DIR"
        fi
    fi
}

#
# Set DOCKER_COMOPSE and COMPOSE_PROJECT_NAME variables
#
docker_env_variables() {
    # Load version helper for Docker Compose detection
    source "$HELPERS_DIR"/version.sh
    source "$HELPERS_DIR"/project_name.sh

    # One resolved name, shared with Compose. A configured name wins; only its absence is
    # derived from the directory, which is what Compose was already doing on its own while the
    # CLI still believed the name was the empty string.
    hm_resolve_project_name

    if [ -z "${COMPOSE_PROJECT_NAME:-}" ]; then
        hm_fail "$HM_EXIT_PROJECT" "no_project_name" \
            "No project name can be derived from $(basename "${HM_ROOT:-$PWD}")" \
            "Rename the directory, or set COMPOSE_PROJECT_NAME in config/docker/properties.json"
    fi

    #
    # A worktree with an environment of its own resolves against itself: its own project, its
    # own volumes, its own mounts. The registration lives outside the checkout, which is what
    # makes it possible to tell this case from the one WT-01 refuses — a worktree borrowing the
    # main environment's identity.
    #
    export HM_WORKTREE_ENVIRONMENT=false

    if [ "${HM_IS_WORKTREE:-false}" == "true" ]; then
        source "$TASKS_DIR"/worktree_env.sh

        if hm_worktree_load "$COMPOSE_PROJECT_NAME" "$HM_WORKTREE"; then
            export HM_WORKTREE_ENVIRONMENT=true
            export HM_MAIN_ROOT="$HM_ROOT"
            export HM_PARENT_PROJECT="$COMPOSE_PROJECT_NAME"
            export HM_WORKTREE_OVERLAY
            HM_WORKTREE_OVERLAY=$(hm_worktree_overlay_file "$COMPOSE_PROJECT_NAME" "$HM_WORKTREE")
            HM_ROOT="$WORKTREE_PATH"
            COMPOSE_PROJECT_NAME="$WORKTREE_PROJECT"
            export HM_PROFILE="$WORKTREE_PROFILE"
            export DOMAIN="$WORKTREE_DOMAIN"
        fi
    fi

    export COMPOSE_PROJECT_NAME

    # Auto-detect Docker Compose command (v1 or v2)
    local compose_cmd=$(get_docker_compose_cmd)

    if [ "$HM_WORKTREE_ENVIRONMENT" == "true" ]; then
        # The project directory is this worktree, which is the whole point: the relative bind
        # mounts of the compose file resolve here, and the overlay carries the profile and the
        # routing. The project's own proxy overlay is deliberately not loaded — it claims the
        # main environment's address.
        export DOCKER_COMPOSE="$compose_cmd --project-directory $HM_ROOT -f $HM_ROOT/$DOCKER_COMPOSE_FILE -f $HM_ROOT/$DOCKER_COMPOSE_FILE_MACHINE -f $HM_WORKTREE_OVERLAY"
    elif [ "${HM_IS_WORKTREE:-false}" == "true" ]; then
        # Absolute paths plus --project-directory: without it, the relative bind mounts of
        # the compose file resolve against this worktree and `up` would repoint the main
        # environment at it
        export DOCKER_COMPOSE="$compose_cmd --project-directory $HM_ROOT -f $HM_ROOT/$DOCKER_COMPOSE_FILE -f $HM_ROOT/$DOCKER_COMPOSE_FILE_MACHINE"
    else
        export DOCKER_COMPOSE="$compose_cmd -f $DOCKER_COMPOSE_FILE -f $DOCKER_COMPOSE_FILE_MACHINE"
    fi

    # A project routed through the global proxy carries a third file: it removes the published
    # ports and adds the routing. Generated by `setup`, so its absence just means this project
    # does not use the proxy.
    if [ "$HM_WORKTREE_ENVIRONMENT" != "true" ] && [ -f "${DOCKER_COMPOSE_FILE%.yml}.proxy.yml" ]; then
        export DOCKER_COMPOSE="$DOCKER_COMPOSE -f ${DOCKER_COMPOSE_FILE%.yml}.proxy.yml"
    fi
    # Not resolved here: only three callers need it (template generation, the doctor check
    # and describe), and asking Docker for it cost ~190ms on every invocation
    export HM_COMPOSE_VERSION_CACHE="${HM_COMPOSE_VERSION_CACHE:-}"
}

#
# Validate command that need docker
#
validate_command() {
    # TODO: Change to in_array
    if [[
        "$1" != "setup" &&
        "$1" != "create-project" &&
        "$1" != "docker-stop-all" &&
        "$1" != "docker-remove-all" &&
        "$1" != "compatibility" &&
        "$1" != "update" &&
        "$1" != "ai-init" &&
        "$1" != "ai-pull" &&
        "$1" != "ai-reset" &&
        "$1" != "list" &&
        "$1" != "doctor" &&
        "$1" != "switch" &&
        "$1" != "tui" &&
        "$1" != "version" &&
        "$1" != "clean" &&
        "$1" != "proxy" &&
        "$1" != "permissions" &&
        "$1" != "mcp"
    ]]; then
        source "$HELPERS_DIR"/docker.sh
        is_docker_service_running
        "$TASKS_DIR"/validate_docker_compose.sh
    fi
}

#
# Refuse, from a worktree, the commands that would recreate or destroy the environment of
# the main checkout
#
validate_worktree() {
    local command_name="$1"

    if [ "${HM_IS_WORKTREE:-false}" != "true" ]; then
        return 0
    fi

    # A worktree with an environment of its own has nothing to protect the main one from: the
    # containers, the volumes and the mounts are its own
    if [ "${HM_WORKTREE_ENVIRONMENT:-false}" == "true" ]; then
        return 0
    fi

    if hm_alters_environment "$command_name" && [ "${HM_FORCE:-}" != "1" ]; then
        if is_json_output; then
            json_error "$command_name" "$HM_EXIT_BLOCKED" "blocked_in_worktree" \
                "'$command_name' is refused from a worktree: it would recreate or destroy the environment of $HM_ROOT with the mounts of this worktree" \
                "Run it from $HM_ROOT, or repeat with --force"
        else
            print_warning "\nYou are in a git worktree ($HM_WORKTREE).\n"
            print_default "The environment belongs to the main checkout:\n  "
            print_code "$HM_ROOT\n\n"
            print_default "Running "
            print_code "$COMMAND_BIN_NAME $command_name"
            print_default " here would recreate or destroy that environment with the mounts of this worktree.\n\n"
            print_default "  Run it from the main checkout, or repeat with "
            print_code "--force"
            print_default " if that is really what you want.\n\n"
        fi

        exit "$HM_EXIT_BLOCKED"
    fi

    if hm_operates_on_code "$command_name"; then
        print_warning_line "Note: the containers serve the code of $HM_ROOT, not this worktree."
    fi
}

#
# Execute of hm command
#
execute() {
    # Initailize directory paths variables
    init_dirs
    # Import neecessary dependencies
    import_dependencies
    # Split global options (--json, --no-json, --yes) from the command arguments
    parse_global_options "$@"
    set -- ${HM_ARGS[@]+"${HM_ARGS[@]}"}
    # Decide between human readable and machine readable output
    resolve_output_format
    # Colours are loaded before the flags are parsed, so the decision is taken again now
    # that --no-color is known. Reassigning keeps the export attribute they already have.
    load_colors
    # Show help information when there is an argument --help or -h
    execute_process_hm_options "$@"

    command_name="${1:-""}.sh"
    export HM_COMMAND="${1:-""}"

    # Check if exit command
    check_command_dir "$1"
    # Set composer project name
    docker_env_variables
    # Export the metadata stamped on the containers as hm.* labels. The expensive ones are
    # only resolved for the commands that can create containers.
    set_environment_labels
    hm_creates_containers "$1" && set_environment_labels_full
    # Refuse what would damage the environment of the main checkout
    validate_worktree "$1"
    # Validation docker compose
    validate_command "$1"
    # Remove command name and pass remaining arguments directly
    shift

    "$COMMANDS_DIR/$command_name" "$@"
}


execute "$@"
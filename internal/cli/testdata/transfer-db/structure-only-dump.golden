dump=$(command -v mariadb-dump || command -v mysqldump); client=$(command -v mariadb || command -v mysql); db='main'; p1='cde_*'; p2='*_data_exporter_*'; p3='*_sync_batches'; p4='*_index_batches'; p5='my_log'; p6='tmp_*'; nl=$(printf '\n_'); nl=${nl%_}; if tables=$("$client" -h'database.internal' -u'mysql' -P '3306' -p'pw' -N -B -r -e "SELECT TABLE_NAME FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() AND TABLE_TYPE = 'BASE TABLE'" "$db"); then set --; ifs=$IFS; IFS=$nl; set -f; for t in $tables; do case $t in $p1|$p2|$p3|$p4|$p5|$p6) set -- "$@" "$t"; printf 'hm-transfer-db-structure-only: %s\n' "$t" >&2;; esac; done; IFS=$ifs; set +f; { s=0; if [ $# -gt 0 ]; then "$dump" --single-transaction --quick --no-tablespaces --skip-comments -h'database.internal' -u'mysql' -P '3306' -p'pw' --no-data "$db" "$@" || s=$?; fi; if [ $s -ne 0 ]; then echo "hm-transfer-db: the structure-only dump exited with status $s" >&2; else for t do set -- "$@" "--ignore-table=$db.$t"; shift; done; "$dump" --single-transaction --quick --no-tablespaces --skip-comments -h'database.internal' -u'mysql' -P '3306' -p'pw' "$db" "$@" || echo "hm-transfer-db: the dump exited with status $?" >&2; fi; } | { sed -e 's/DEFINER[ ]*=[ ]*[^*]*\*/\*/' || echo "hm-transfer-db: sed exited with status $?" >&2; } | gzip -9; else echo "hm-transfer-db: listing the tables exited with status $?" >&2; fi

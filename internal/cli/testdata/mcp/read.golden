{"jsonrpc":"2.0","id":2,"result":{"tools":[{"name":"describe_project","description":"What the Magento project in the current directory is: PHP, database and search versions, the services and whether they are running, its URLs and its deploy mode.","inputSchema":{"type":"object","properties":{"environment":{"type":"string","description":"A branch environment of this project, by the name hm worktree list gives it. Leave it out for the current directory."}},"additionalProperties":false},"outputSchema":{"type":"object","properties":{"project":{"type":"object","description":"Name, root, domain, status and URLs"},"magento":{"type":"object","description":"Version and deploy mode"},"data":{"type":"object","description":"Whether the database is anonymised, and since when"},"services":{"type":"array","description":"Each service with its image, version and state"},"paths":{"type":"object","description":"Magento directory, workdir, sync strategy and compose files"},"tooling":{"type":"object","description":"Machine, hm, Compose and xdebug"}}},"annotations":{"readOnlyHint":true}},{"name":"list_environments","description":"Every Dockergento environment on this machine, with the directory it belongs to, its branch and its state. Use it to find out what else is running.","inputSchema":{"type":"object","properties":{},"additionalProperties":false},"outputSchema":{"type":"object","properties":{"environments":{"type":"array","description":"Each environment with its name, root, branch, containers and status"},"count":{"type":"integer"}}},"annotations":{"readOnlyHint":true}},{"name":"check_environment","description":"Run the diagnostics (hm doctor) and return each check with its result. Use it when something does not work and you do not know why yet.","inputSchema":{"type":"object","properties":{"environment":{"type":"string","description":"A branch environment of this project, by the name hm worktree list gives it. Leave it out for the current directory."}},"additionalProperties":false},"outputSchema":{"type":"object","properties":{"checks":{"type":"array","description":"Each finding with its id, scope, severity, message and action"},"summary":{"type":"object","description":"How many checks, and how many are ok, warnings and errors"}}},"annotations":{"readOnlyHint":true}},{"name":"environment_status","description":"How the environment is doing right now, in one call (hm status): each container's state and the last error its log reported, whether the URLs answer, xdebug on or off, the deploy mode and whether the database is anonymised. Use it after a change, to see whether something broke.","inputSchema":{"type":"object","properties":{"environment":{"type":"string","description":"A branch environment of this project, by the name hm worktree list gives it. Leave it out for the current directory."}},"additionalProperties":false},"outputSchema":{"type":"object","properties":{"project":{"type":"string"},"state":{"type":"string","description":"running, partial or stopped"},"mode":{"type":"string","description":"Magento's deploy mode"},"xdebug":{"type":"string","description":"on, off or unknown"},"anonymised":{"type":"string","description":"yes, or unknown: unknown is never safe"},"services":{"type":"array","description":"Each service with its state, whether it runs and the last error line of its log"},"urls":{"type":"array","description":"Each URL, whether it answers and with which HTTP code"}}},"annotations":{"readOnlyHint":true}},{"name":"service_logs","description":"The last lines of one service's log. Services are named as in the compose file: phpfpm, nginx, db, search, redis, varnish.","inputSchema":{"type":"object","properties":{"service":{"type":"string","description":"The service whose log to read"},"lines":{"type":"integer","description":"How many lines from the end (default 100)"},"environment":{"type":"string","description":"A branch environment of this project, by the name hm worktree list gives it. Leave it out for the current directory."}},"required":["service"],"additionalProperties":false},"annotations":{"readOnlyHint":true}},{"name":"database_query","description":"Run one read-only SQL statement against this project's database and return the rows. Only SELECT, SHOW, DESCRIBE and EXPLAIN are accepted; anything that writes is refused.","inputSchema":{"type":"object","properties":{"sql":{"type":"string","description":"A single SELECT, SHOW, DESCRIBE or EXPLAIN statement"},"environment":{"type":"string","description":"A branch environment of this project, by the name hm worktree list gives it. Leave it out for the current directory."}},"required":["sql"],"additionalProperties":false},"annotations":{"readOnlyHint":true}}]}}
